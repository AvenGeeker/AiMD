{
  "name": "@aimarkdown/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "aiMarkdown desktop shell: main window, tray and a global-hotkey quick-capture window.",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm build:web && pnpm build:main && node scripts/copy-renderer.mjs",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "pnpm build:web && node scripts/copy-renderer.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac --x64 --arm64",
    "dist:win": "pnpm build && electron-builder --win --x64",
    "build:web": "pnpm --filter @aimarkdown/web build",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "~5.9.3",
    "@types/markdown-it": "^14.2.0",
    "@types/turndown": "^5.0.6",
    "@aimarkdown/shared": "workspace:*",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.aimarkdown.desktop",
    "productName": "aiMarkdown",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "\u7528\u4e8e\u8bfb\u53d6\u548c\u5199\u5165 macOS \u5907\u5fd8\u5f55\uff0c\u5b9e\u73b0\u53cc\u5411\u540c\u6b65\u3002"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
