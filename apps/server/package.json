{
  "name": "@aimarkdown/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "migrate": "tsx src/scripts/migrate-cli.ts",
    "test": "pnpm test:unit",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@aimarkdown/markdown": "workspace:*",
    "@aimarkdown/shared": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@hocuspocus/extension-database": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.7",
    "jose": "^6.2.14",
    "nanoid": "^6.0.2",
    "postgres": "^4.0.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.33",
    "zod": "^4.6.7",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "@hocuspocus/provider": "^4.8.0",
    "y-indexeddb": "^9.0.12"
  }
}
