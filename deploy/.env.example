# Copy to deploy/.env (deploy.sh does this for you and fills in random secrets).

# ---------------------------------------------------------------------------
# 对外访问地址（必填，带协议）。这里是 Caddy 的站点地址，同时用于生成附件绝对链接。
#
# 两种部署模式：
#
# 1) 域名模式（推荐，自动 HTTPS）：
#      PUBLIC_URL=https://notes.example.com
#      Caddy 自动申请 / 续期 Let's Encrypt 证书，80 跳转 443。
#
# 2) 无域名 / IP 直连（纯 HTTP 试用）：
#      PUBLIC_URL=http://203.0.113.10:8080
#      CADDY_SITE_ADDR=http://203.0.113.10        ← 注意：不带端口（IP 便于记忆可不写）
#      HTTP_PORT=8080                             ← 大陆区 ECS 未备案时 80 会被拦截，用非标端口
#
# 建议值：域名模式填域名即可；IP 直连若无备注端口，PUBLIC_URL 写 http://<IP>
# （HTTP_PORT=80 时端口可省略）。
# ---------------------------------------------------------------------------
PUBLIC_URL=

# Caddy 站点监听地址（deploy.sh 自动推导，一般无需手填）：
#   域名模式 = https://<域名>；IP 直连 = http://<IP>（不带端口，Caddy 在容器内绑定 80，
#   宿主机对外端口由 HTTP_PORT 决定）。
# 仅当 PUBLIC_URL 带非 80 端口时才需要显式设置，否则保持为空即可。
CADDY_SITE_ADDR=

# Email Let's Encrypt 用于证书到期通知（仅域名模式有效）。
ACME_EMAIL=you@example.com

# --- secrets: deploy.sh generates these with `openssl rand` ---
JWT_SECRET=
POSTGRES_PASSWORD=

POSTGRES_USER=aimarkdown
POSTGRES_DB=aimarkdown

# 宿主机对外端口。域名模式：80=HTTP 跳转 / 443=HTTPS；
# IP 直连模式：仅 HTTP_PORT 生效（建议 80 被占用或大陆区未备案时改 8080 等非标端口），HTTPS_PORT 可忽略。
HTTP_PORT=80
HTTPS_PORT=443

# Set to false to disable self-service registration once your accounts exist.
ALLOW_REGISTRATION=true

# Optional: create/flag an admin on first boot. Leave blank to skip.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Leave as * when the SPA is served from the same origin (the default deployment).
CORS_ORIGIN=*

# Leave empty: Caddy proxies /collab to the collaboration port. Only set this (e.g.
# wss://notes.example.com:1234) if you expose the app container without the bundled Caddy.
COLLAB_PUBLIC_URL=

# Set to a prebuilt image to skip building on the server. CI publishes
# ghcr.io/<owner>/<repo>:latest plus :main, :sha-* and version tags; `aimd.sh update` pulls
# remote tags before switching, so a rolling :latest tag is safe here.
# For a local `docker load` image, use a bare tag such as aimarkdown-app:local.
APP_IMAGE=

LOG_LEVEL=info
