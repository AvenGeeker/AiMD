# Copy to deploy/.env (deploy.sh does this for you and fills in random secrets).

# Public hostname Caddy will obtain a certificate for, e.g. notes.example.com
PUBLIC_URL=notes.example.com
# Email Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.com

# --- secrets: deploy.sh generates these with `openssl rand` ---
JWT_SECRET=
POSTGRES_PASSWORD=

POSTGRES_USER=aimarkdown
POSTGRES_DB=aimarkdown

# Host ports Caddy binds. Change these when something else already owns 80/443, or when you put
# aiMarkdown behind an existing reverse proxy.
HTTP_PORT=80
HTTPS_PORT=443

# Set to false to disable self-service registration once your accounts exist.
ALLOW_REGISTRATION=true

# Optional: create/flag an admin on first boot. Leave blank to skip.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Leave as * when the SPA is served from the same origin (the default deployment).
CORS_ORIGIN=*

# Leave empty: Caddy proxies /collab to the collaboration port. Only set this (e.g.
# wss://notes.example.com:1234) if you expose the app container without the bundled Caddy.
COLLAB_PUBLIC_URL=

# Set to a prebuilt image (e.g. ghcr.io/you/aimarkdown:0.1.0) to skip building on the server.
APP_IMAGE=

LOG_LEVEL=info
