# Caddy terminates TLS and routes by path.
#
# Hocuspocus ignores the request path, so stripping the /collab prefix before proxying is enough —
# no sticky sessions or custom upgrade handling beyond Caddy's default WebSocket passthrough.

{
	# Caddy reads ACME_EMAIL from the environment natively, so an empty value is fine — it just
	# means no expiry notices. (An `email` directive with an empty argument is a hard config error.)
	#
	# Uncomment to use a staging CA while testing certificate issuance:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$PUBLIC_URL} {
	encode zstd gzip

	# Collaboration WebSocket -> Hocuspocus. handle_path strips the /collab prefix.
	handle_path /collab* {
		reverse_proxy app:1234
	}

	# REST API and attachments.
	handle /api/* {
		reverse_proxy app:3000
	}

	# Everything else is the built web client, served by Fastify.
	handle {
		reverse_proxy app:3000
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
