# Copy to .env and adjust. deploy.sh generates a populated .env automatically.
NODE_ENV=development
HOST=0.0.0.0
REST_PORT=3000
COLLAB_PORT=1234

DATABASE_URL=postgres://aimarkdown:aimarkdown_dev@localhost:5433/aimarkdown
# Must be at least 32 characters and unique per deployment.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

CORS_ORIGIN=*
ALLOW_REGISTRATION=true

UPLOAD_DIR=./data/uploads
# Public origin used for attachment and share links. When running the Vite UI separately, use its address.
PUBLIC_URL=http://localhost:3000

# Reserved for a future Chinese word-segmentation driver; only `trgm` is implemented.
SEARCH_DRIVER=trgm

LOG_LEVEL=info
# Point at apps/web/dist to have the server host the built web client.
WEB_DIST_DIR=

# Session lifetimes (seconds). Remembered devices rotate a one-year token.
# REFRESH_TOKEN_TTL_SECONDS=2592000
# REMEMBERED_REFRESH_TOKEN_TTL_SECONDS=31536000
# REFRESH_ROTATION_GRACE_SECONDS=60

# Optional: dedicated AES key for stored per-user AI provider credentials.
# If blank, a key is derived from JWT_SECRET (rotating JWT_SECRET invalidates saved AI keys).
# AI_CREDENTIALS_SECRET=change-me-to-another-long-random-string
# Allow local/private OpenAI-compatible endpoints such as Ollama. Keep false in production.
AI_ALLOW_PRIVATE_BASE_URL=false
# AI_REQUEST_TIMEOUT_MS=90000
# AI_REQUEST_INTERVAL_MS=750
# AI_MAX_CHUNK_CHARS=16000
# AI_MAX_CHUNKS=48

# Favourite media processing
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Only enable for local link sources/tests; keep false in public deployments.
LINK_FETCH_ALLOW_PRIVATE=false
LINK_FETCH_TIMEOUT_MS=15000
LINK_FETCH_MAX_BYTES=8388608
LINK_FETCH_MAX_IMAGES=20
LINK_FETCH_MAX_IMAGE_BYTES=10485760
LINK_FETCH_MAX_TOTAL_MEDIA_BYTES=41943040
MEDIA_MAX_DURATION_SECONDS=7200
